meta {
  name: Update template
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/templates/{{templateId}}
  body: json
  auth: inherit
}

body:json {
  {
    "visibility": "restricted",
    "allow_vm_creation": true
  }
}

assert {
  res.status: eq 200
}

docs {
  Admin only. Body: UpdateTemplate {name, packer_config, disk_name, pool, visibility, allow_vm_creation}, every field optional.
  allow_vm_creation: false refuses POST .../vms for everyone, admins included (409); the template stays listed.
  Existing versions are not changed: run "Rebuild template" to build a new version from the edited definition.
}
