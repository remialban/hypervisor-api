meta {
  name: Delete template
  type: http
  seq: 17
}

delete {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/templates/{{templateId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

docs {
  Admin only. Deletes the template, all its versions and their disks. VMs created from it keep
  their own copy. 409 while a build is running: stop it first.
}
