meta {
  name: Get template
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/templates/{{templateId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

docs {
  One template: its definition, its visibility, default_version and latest_version
  (status: pending, in_progress, stopping, created, failed or cancelled).
  A build interrupted by a restart of the API is reported as failed.
}
