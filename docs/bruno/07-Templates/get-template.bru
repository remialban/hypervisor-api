meta {
  name: Get template
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/templates/{{templateId}}
  body: none
  auth: inherit
}

vars:pre-request {
  hypervisorId: b24139f9-220d-4efa-b416-a14b54678ef0
}

assert {
  res.status: eq 200
}

docs {
  One template and the state of its build: pending, in_progress, created or failed.
  A build interrupted by a restart of the API is reported as failed.
}
