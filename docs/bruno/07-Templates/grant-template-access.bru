meta {
  name: Grant template access
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/templates/{{templateId}}/access/{{userId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

docs {
  Admin only. Lets the user use a "restricted" template. They also need the grant on the hypervisor.
}
