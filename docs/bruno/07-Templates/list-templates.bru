meta {
  name: List templates
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/templates
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

docs {
  The templates the caller has a right on (admins: all), each with access {level, max_vms, vm_count}:
  level is use, manage or admin; max_vms how many VMs from it the caller may own (null: no limit).
  Users see a template once it has a built version, without packer_config; managers see it at once.
  A "hypervisor" template is also usable by every user granted the hypervisor; a "restricted" one
  only through permissions given to the user or to one of their groups (nested groups included).
  default_version is the version used to create VMs when none is given (latest built one).
}
