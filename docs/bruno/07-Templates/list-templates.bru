meta {
  name: List templates
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/templates
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

docs {
  Templates of the hypervisor. Needs a grant on it (admins have it everywhere).
  Admins see every template with its packer_config, and the state of its latest build.
  Users only see the templates that have a built version and are open to them
  (visibility "hypervisor", or "restricted" with an access entry), without packer_config.
  default_version is the version used to create VMs when none is given (latest built one).
}
