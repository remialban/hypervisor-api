meta {
  name: Revoke template access
  type: http
  seq: 14
}

delete {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/templates/{{templateId}}/access/{{userId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

docs {
  Admin only. The user no longer sees the template (if it is "restricted"). Their VMs are not touched.
}
