meta {
  name: Create VM from template
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/templates/{{templateId}}/vms
  body: json
  auth: inherit
}

body:json {
  {
    "name": "vm-from-template",
    "memory_mb": 2048,
    "vcpus": 2,
    "start": true
  }
}

assert {
  res.status: eq 202
}

script:post-response {
  if (res.status === 202) { bru.setEnvVar("jobId", res.body.id); }
}

docs {
  Body: CreateVmFromTemplate {name, memory_mb, vcpus, network, firmware, start, owner_id (admin only)}.
  Needs a grant on the hypervisor and a created template; counts in the quota (the template disk size counts as disk_gb).
  Asynchronous: returns 202 with a Job (Location: /api/jobs/{id}), the disk is copied (<name>.qcow2, independent of the template).
  The caller (or owner_id) owns the new VM.
}
