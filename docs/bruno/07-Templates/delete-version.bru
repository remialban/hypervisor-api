meta {
  name: Delete version
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/templates/{{templateId}}/versions/{{templateVersionId}}
  body: none
  auth: inherit
}

assert {
