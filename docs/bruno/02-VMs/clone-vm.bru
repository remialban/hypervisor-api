meta {
  name: Clone VM
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/vms/{{vmId}}/clone
  body: json
  auth: none
}

body:json {
  {
    "name": "vm-01-clone"
  }
}

assert {
  res.status: eq 202
}

script:post-response {
  bru.setEnvVar("jobId", res.body.id);
}

docs {
  Asynchronous: returns 202 with a Job (Location: /api/jobs/{id}); the jobId variable is set for the "Get job" request. The source VM must be stopped. The copy of the disks can take minutes. Poll "Get job" until status is succeeded or failed.
}
