meta {
  name: Stop VM
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/vms/{{vmId}}/stop?force=true
  body: none
  auth: none
}

params:query {
  force: true
}

assert {
  res.status: eq 200
}

docs {
  Graceful ACPI shutdown (asynchronous: the guest may still be running in the response, and a guest that ignores ACPI never stops). Add ?force=true to cut the power. 409 if the VM is already stopped.
}
