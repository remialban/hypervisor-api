meta {
  name: Start VM
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/vms/{{vmId}}/start
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

docs {
  Starts a stopped VM and returns it with its new state. 409 if the VM is already running.
}
