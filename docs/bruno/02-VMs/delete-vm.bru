meta {
  name: Delete VM
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/vms/{{vmId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

docs {
  Deletes a stopped VM (definition and NVRAM); its disk files are kept. Add ?delete_disks=true to also delete the disk volumes (refused with 409 if a disk is shared with another VM or is not in a storage pool). 409 if the VM is running.
}
