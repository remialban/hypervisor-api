meta {
  name: Create VM
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/vms
  body: json
  auth: none
}

body:json {
  {
    "name": "vm-01",
    "memory_mb": 2048,
    "vcpus": 2,
    "disks": [{ "pool": "datastore", "size_gb": 20 }],
    "network": "default",
    "firmware": "bios",
    "start": false
  }
}

assert {
  res.status: eq 201
}

docs {
  Creates a VM from what "Get VM creation options" offers. disks: each one is new ({pool, size_gb}) or existing ({pool, volume}, not used by another VM). Optional iso {pool, volume}, network (default "default"), firmware ("bios" | "uefi"), start (default false). Returns the VM. 400 invalid values, 404 unknown pool/volume/network, 409 name taken or disk already used.
}
