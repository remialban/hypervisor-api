meta {
  name: Update disk
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/disks/{{diskId}}
  body: json
  auth: none
}

body:json {
  {
    "size_gb": 40
  }
}

assert {
  res.status: eq 501
}

docs {
  The local test driver does not support volume resizing and returns 501. With a supporting driver, resizing succeeds with 200. Shrinking is rejected to avoid data loss.
}
