meta {
  name: Create disk
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/disks
  body: json
  auth: none
}

body:json {
  {
    "name": "disk-{{$guid}}",
    "size_gb": 20,
    "format": "qcow2"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("diskId", encodeURIComponent(res.body.id));
  }
}

docs {
  Creates a uniquely named volume and stores its URL-encoded libvirt key in diskId for Get disk.
}
