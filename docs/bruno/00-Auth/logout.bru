meta {
  name: Logout
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}{{apiPrefix}}/auth/logout
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "{{refreshToken}}"
  }
}

assert {
  res.status: eq 204
}

docs {
  Revokes the refresh token. The access token stays valid until it expires (15 minutes by default).
}
