meta {
  name: Refresh tokens
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}{{apiPrefix}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "{{refreshToken}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.access_token);
    bru.setVar("refreshToken", res.body.refresh_token);
  }
}

docs {
  Exchanges the refresh token (single use) for a new access token + refresh token. 401 if it was already used, expired, or the account is disabled.
}
