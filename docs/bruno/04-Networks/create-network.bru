meta {
  name: Create network
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPrefix}}/hypervisors/{{hypervisorId}}/networks
  body: json
  auth: inherit
}

body:json {
  {
    "name": "net-{{$guid}}"
  }
}

assert {
  res.status: eq 201
}

docs {
  Defines and starts an isolated network. The bridge is optional and libvirt may assign one automatically.
}
