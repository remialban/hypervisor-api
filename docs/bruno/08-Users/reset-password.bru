meta {
  name: Reset password (admin)
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}{{apiPrefix}}/users/{{userId}}/password
  body: json
  auth: inherit
}

body:json {
  {
    "new_password": "another long password"
  }
}

assert {
  res.status: eq 204
}

docs {
  Admin only. Closes every session of the account.
}
