meta {
  name: Change my password
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}{{apiPrefix}}/me/password
  body: json
  auth: inherit
}

body:json {
  {
    "current_password": "{{adminPassword}}",
    "new_password": "{{adminPassword}}"
  }
}

assert {
  res.status: eq 204
}

docs {
  Needs the current password (401 otherwise). Closes every other session of the account.
}
