FROM debian:trixie-slim

# Installation de websockify et noVNC
RUN apt-get update && apt-get install -y \
    novnc \
    websockify \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Le fichier token -> hôte:port est écrit par l'API dans le volume partagé /data
# (variable VM_CONFIG_PATH, lue par le script de démarrage).
COPY docker/novnc-entrypoint.sh /usr/local/bin/novnc-entrypoint.sh
RUN chmod +x /usr/local/bin/novnc-entrypoint.sh

# Création d'un lien symbolique pour que la racine web pointe directement sur vnc.html
RUN ln -sf /usr/share/novnc/vnc.html /usr/share/novnc/index.html

# Port par défaut de noVNC / websockify
EXPOSE 6080

# Démarre websockify avec authentification par token (tokens courts émis par l'API)
ENTRYPOINT ["novnc-entrypoint.sh"]
