# Copier ce fichier en .env puis adapter les valeurs. Ne jamais committer .env.

# --- Docker Hub (déploiement ou pull d'images) ---
DOCKERHUB_USERNAME=remi
TAG=latest

# --- Hyperviseurs ---
# Chemin de votre clé SSH privée sur la machine hôte
SSH_PRIVATE_KEY_HOST_PATH=/home/user/.ssh/id_ed25519

# --- HTTPS (HAProxy, voir docs/HAPROXY.md) ---
# Certificat du serveur (suivi de la chaîne), en PEM.
TLS_CERT_PATH=/etc/hypervisor-api/tls/cert.pem
# Clé privée, en PEM, non chiffrée, lisible par l'UID 99 (chown 99:99 + chmod 400).
TLS_KEY_PATH=/etc/hypervisor-api/tls/key.pem
# Ports publiés sur l'hôte : HTTP (redirigé vers HTTPS) et HTTPS.
HTTP_PORT=80
HTTPS_PORT=443

# --- noVNC ---
# URL de noVNC vue par le navigateur : l'adresse HTTPS de HAProxy (nom du certificat).
NOVNC_URL=https://localhost/vnc.html

# --- Authentification ---
# Secret de signature des JWT : 32 caractères minimum. Générer par exemple avec :
#   openssl rand -base64 48
JWT_SECRET=change-me-with-at-least-32-random-characters

# Premier administrateur, créé au premier démarrage si la base est vide.
# Changer ce mot de passe depuis l'API (PUT /api/me/password) après la première connexion.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Origines du front Angular autorisées (CORS), séparées par des virgules.
# Le front servi sur une autre origine que l'API en a besoin (en https:// derrière HAProxy) ;
# s'il est servi par la même adresse que l'API, laisser vide.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Durées de vie en secondes (valeurs par défaut).
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800
# VNC_TOKEN_TTL_SECONDS=120
